{
  "name": "@mathlabs/voltik",
  "version": "0.4.0",
  "description": "CircuiTikZ circuits to SVG and PNG, without a TeX install. A library of tikra; math labels typeset by mathra. Runs on WebAssembly in Node, bundlers and browsers.",
  "keywords": [
    "circuitikz",
    "tikz",
    "latex",
    "circuit",
    "schematic",
    "electronics",
    "svg",
    "png",
    "webassembly",
    "rust",
    "python",
    "cli",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/matheusmota-dev-br/voltik#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheusmota-dev-br/voltik.git",
    "directory": "npm"
  },
  "bugs": "https://github.com/matheusmota-dev-br/voltik/issues",
  "license": "(MIT OR Apache-2.0) AND OFL-1.1 AND LicenseRef-GUST-Font-License",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./index.d.ts",
          "default": "./node/index.mjs"
        },
        "require": {
          "types": "./index.d.cts",
          "default": "./node/index.cjs"
        }
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./web/index.js"
      }
    },
    "./voltik.wasm": "./voltik.wasm",
    "./package.json": "./package.json"
  },
  "main": "./node/index.cjs",
  "module": "./web/index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "web",
    "node",
    "voltik.wasm",
    "index.d.ts",
    "index.d.cts",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "OFL-STIXTwoMath.txt",
    "GUST-FONT-LICENSE-LatinModernMath.txt"
  ]
}